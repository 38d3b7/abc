{
  "name": "@abc/executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ABC executor: typed-intent pipeline, signer adapters, worker, agent loop",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --import tsx --env-file-if-exists=.env src/index.ts",
    "worker": "node --import tsx --env-file-if-exists=.env src/worker/index.ts",
    "migrate": "node --import tsx --env-file-if-exists=.env src/db/migrate.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "skill-registry": "node --import tsx script/skill-registry.ts",
    "skill-import": "node --import tsx script/skill-import.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.102",
    "@circle-fin/developer-controlled-wallets": "^9.2.0",
    "@hono/node-server": "^1.19.5",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "ai": "^7.0.126",
    "hono": "^4.10.1",
    "pg": "^8.16.3",
    "pg-boss": "^12.4.0",
    "viem": "^2.37.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
